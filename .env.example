# PostgreSQL connection string
DATABASE_URL=postgresql://sushi:sushi@localhost:5432/sushi_photography

# Secret used to sign admin session cookies. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more

# First admin account (created by `npm run admin:create`)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Where uploaded images are stored on disk (served at /media/...)
UPLOAD_DIR=./uploads
